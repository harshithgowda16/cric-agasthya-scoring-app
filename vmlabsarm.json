{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "CloudLabs - Linux container VM (Guacamole gateway). Determines the target VNet by reading the ATTENDEE WINDOWS VM'S OWN NIC subnet reference directly from Azure (NIC-<deploymentId> in ODL-5-<deploymentId>), rather than depending on GET-EXISTING-VNET-* token substitution or custom tags surviving from vm.json - both have proven unreliable. Since the attendee VM only exists because it successfully attached to a real subnet, its NIC is unconditional ground truth for which VNet/RG is actually in use, whether that VNet is a freshly created cloudlabs-vnet-<id> or a pre-existing customer VNet. From there it ensure-creates container-subnet (auto-sized via cidrSubnet from the VNet's own address space - a no-op if vm.json's own copy already created it) and deploys the gateway VM into it."
  },
  "parameters": {
    "deploymentId": {
      "type": "string",
      "metadata": {
        "description": "GET-DEPLOYMENT-ID"
      }
    },
    "windowsVmResourceGroup": {
      "type": "string",
      "defaultValue": "[concat('ODL-5-', parameters('deploymentId'))]",
      "metadata": {
        "description": "Resource group vm.json deploys into - confirmed identical across every real deployment in this environment (ODL-5-<deploymentId>), in BOTH the new-VNet and existing-VNet paths, since only the VNet's own location differs between branches, not where vm.json itself runs."
      }
    },
    "containerSubnetName": {
      "type": "string",
      "defaultValue": "container-subnet",
      "metadata": {
        "description": "Subnet joined on the NEW-VNet path, created by vm.json alongside vm-subnet."
      }
    },
    "linuxVmSize": {
      "type": "string",
      "defaultValue": "Standard_B2als_v2"
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser"
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Login password for the container VM (6-72 chars, 3 of 4 categories)."
      }
    },
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "ACR login server FQDN, e.g. devclacr01.azurecr.io"
      }
    },
    "acrUsername": {
      "type": "string"
    },
    "acrPassword": {
      "type": "securestring"
    },
    "imageName": {
      "type": "string"
    },
    "imageTag": {
      "type": "string"
    },
    "allowedHttpsSource": {
      "type": "string",
      "defaultValue": "*"
    },
    "existingContainerSubnetMask": {
      "type": "int",
      "defaultValue": 24,
      "metadata": {
        "description": "MUST match vm.json's existingContainerSubnetMask so both templates derive the identical prefix."
      }
    },
    "existingContainerSubnetIndex": {
      "type": "int",
      "defaultValue": 200,
      "metadata": {
        "description": "MUST match vm.json's existingContainerSubnetIndex so both templates derive the identical prefix - this is what makes it safe for both to ensure-create the same subnet."
      }
    },
    "windowsNicName": {
      "type": "string",
      "defaultValue": "[concat('NIC-', parameters('deploymentId'))]",
      "metadata": {
        "description": "The attendee Windows VM's NIC, created by vm.json. Its live subnet.id is read directly - this is what makes this template correct regardless of new-VNet or existing-VNet, and regardless of which version of vm.json actually ran, since ANY successful Windows VM deployment produces a NIC genuinely attached to the real subnet. No GET- token or custom tag has to survive intact for this to work."
      }
    }
  },
  "variables": {
    "useExistingVnet": "[and(not(empty(parameters('existingVirtualNetworkName'))), not(startsWith(parameters('existingVirtualNetworkName'), 'GET-')))]",
    "vnetRgProvided": "[and(not(empty(parameters('vnetResourceGroup'))), not(startsWith(parameters('vnetResourceGroup'), 'GET-')))]",
    "subnetProvided": "[and(not(empty(parameters('existingVnetSubnetName'))), not(startsWith(parameters('existingVnetSubnetName'), 'GET-')))]",
    "resolvedVnetName": "[if(variables('useExistingVnet'), parameters('existingVirtualNetworkName'), concat('cloudlabs-vnet-', parameters('deploymentId')))]",
    "resolvedVnetResourceGroup": "[if(variables('useExistingVnet'), if(variables('vnetRgProvided'), parameters('vnetResourceGroup'), parameters('existingVnetFallbackResourceGroup')), parameters('windowsVmResourceGroup'))]",
    "linuxVmName": "[concat('containervm-', parameters('deploymentId'))]",
    "containerDnsLabel": "[concat('rdp-', parameters('deploymentId'), uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "resolve-vnet",
      "comments": "STAGE 1: reads the attendee NIC's live subnet.id (e.g. /subscriptions/x/resourceGroups/harshithEUS2-RG/providers/Microsoft.Network/virtualNetworks/harshithEUS2/subnets/default) and parses it with split('/') to recover the real vnetResourceGroup (index 4) and vnetName (index 8) - ground truth, independent of any token or tag. Outputs those plus region + address space via reference(), which is legal in outputs but never in a location field.",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": [],
          "outputs": {
            "vnetName": {
              "type": "string",
              "value": "[split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[8]]"
            },
            "vnetResourceGroup": {
              "type": "string",
              "value": "[split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[4]]"
            },
            "attendeeSubnetName": {
              "type": "string",
              "value": "[split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[10]]",
              "metadata": {
                "description": "The attendee VM's OWN subnet, exposed for diagnostics only - the container VM does not use this, it gets its own dedicated subnet."
              }
            },
            "location": {
              "type": "string",
              "value": "[reference(resourceId(split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[4], 'Microsoft.Network/virtualNetworks', split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[8]), '2023-09-01', 'full').location]"
            },
            "vnetAddressSpace": {
              "type": "string",
              "value": "[reference(resourceId(split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[4], 'Microsoft.Network/virtualNetworks', split(reference(resourceId(parameters('windowsVmResourceGroup'), 'Microsoft.Network/networkInterfaces', parameters('windowsNicName')), '2023-09-01').ipConfigurations[0].subnet.id, '/')[8]), '2023-09-01').addressSpace.addressPrefixes[0]]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "ensure-container-subnet",
      "dependsOn": [
        "resolve-vnet"
      ],
      "resourceGroup": "[reference('resolve-vnet').outputs.vnetResourceGroup.value]",
      "comments": "STAGE 1b: ensure-creates container-subnet, auto-sized from the resolved VNet's own address space via cidrSubnet() - same formula vm.json uses, so this is a no-op if vm.json's copy already created it (Incremental mode + identical computed prefix), and a real create if that step did not run. Sibling of resolve-vnet, NOT nested inside it - single level of nesting only, since deep nesting's scope rules are unreliable.",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "vnetName": {
            "value": "[reference('resolve-vnet').outputs.vnetName.value]"
          },
          "subnetName": {
            "value": "[parameters('containerSubnetName')]"
          },
          "addressPrefix": {
            "value": "[cidrSubnet(reference('resolve-vnet').outputs.vnetAddressSpace.value, parameters('existingContainerSubnetMask'), parameters('existingContainerSubnetIndex'))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "vnetName": {
              "type": "string"
            },
            "subnetName": {
              "type": "string"
            },
            "addressPrefix": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/virtualNetworks/subnets",
              "apiVersion": "2023-09-01",
              "name": "[concat(parameters('vnetName'), '/', parameters('subnetName'))]",
              "properties": {
                "addressPrefix": "[parameters('addressPrefix')]"
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-10-01",
      "name": "deploy-container-vm",
      "dependsOn": [
        "ensure-container-subnet"
      ],
      "comments": "STAGE 2: receives the resolved region and subnet as ordinary parameters, so no runtime function ever appears in a location field. expressionEvaluationOptions.scope MUST be 'inner' - the ARM default 'outer' would resolve this template's parameters()/variables() against the parent and fail.",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "location": {
            "value": "[reference('resolve-vnet').outputs.location.value]"
          },
          "vnetName": {
            "value": "[reference('resolve-vnet').outputs.vnetName.value]"
          },
          "vnetResourceGroup": {
            "value": "[reference('resolve-vnet').outputs.vnetResourceGroup.value]"
          },
          "subnetName": {
            "value": "[parameters('containerSubnetName')]"
          },
          "linuxVmName": {
            "value": "[variables('linuxVmName')]"
          },
          "containerDnsLabel": {
            "value": "[variables('containerDnsLabel')]"
          },
          "linuxVmSize": {
            "value": "[parameters('linuxVmSize')]"
          },
          "adminUsername": {
            "value": "[parameters('adminUsername')]"
          },
          "adminPassword": {
            "value": "[parameters('adminPassword')]"
          },
          "acrLoginServer": {
            "value": "[parameters('acrLoginServer')]"
          },
          "acrUsername": {
            "value": "[parameters('acrUsername')]"
          },
          "acrPassword": {
            "value": "[parameters('acrPassword')]"
          },
          "imageName": {
            "value": "[parameters('imageName')]"
          },
          "imageTag": {
            "value": "[parameters('imageTag')]"
          },
          "allowedHttpsSource": {
            "value": "[parameters('allowedHttpsSource')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": {
              "type": "string"
            },
            "vnetName": {
              "type": "string"
            },
            "vnetResourceGroup": {
              "type": "string"
            },
            "subnetName": {
              "type": "string"
            },
            "linuxVmName": {
              "type": "string"
            },
            "containerDnsLabel": {
              "type": "string"
            },
            "linuxVmSize": {
              "type": "string"
            },
            "adminUsername": {
              "type": "string"
            },
            "adminPassword": {
              "type": "securestring"
            },
            "acrLoginServer": {
              "type": "string"
            },
            "acrUsername": {
              "type": "string"
            },
            "acrPassword": {
              "type": "securestring"
            },
            "imageName": {
              "type": "string"
            },
            "imageTag": {
              "type": "string"
            },
            "allowedHttpsSource": {
              "type": "string"
            }
          },
          "variables": {
            "publicIpName": "[concat(parameters('linuxVmName'), '-pip')]",
            "containerNsgName": "[concat(parameters('linuxVmName'), '-nsg')]",
            "containerNicName": "[concat(parameters('linuxVmName'), '-nic')]",
            "containerImage": "[concat(parameters('acrLoginServer'), '/', parameters('imageName'), ':', parameters('imageTag'))]",
            "cloudInit": "#!/bin/bash\nset -x\napt-get update -y\napt-get install -y docker.io\nsystemctl enable --now docker\nfor i in $(seq 1 12); do\n  set +x\n  printf '%s' '{0}' | docker login '{1}' --username '{2}' --password-stdin\n  LOGIN_RC=$?\n  set -x\n  if [ \"$LOGIN_RC\" -eq 0 ] && docker pull \"{3}\"; then break; fi\n  sleep 15\ndone\ndocker run -d --name gauc --restart unless-stopped -p 443:443 \"{3}\"\ndocker logout '{1}'\n"
          },
          "resources": [
            {
              "type": "Microsoft.Network/publicIPAddresses",
              "apiVersion": "2023-09-01",
              "name": "[variables('publicIpName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard"
              },
              "properties": {
                "publicIPAllocationMethod": "Static",
                "dnsSettings": {
                  "domainNameLabel": "[parameters('containerDnsLabel')]"
                }
              }
            },
            {
              "type": "Microsoft.Network/networkSecurityGroups",
              "apiVersion": "2023-09-01",
              "name": "[variables('containerNsgName')]",
              "location": "[parameters('location')]",
              "properties": {
                "securityRules": [
                  {
                    "name": "AllowHttps",
                    "properties": {
                      "description": "HTTPS to the Guacamole web app.",
                      "priority": 100,
                      "direction": "Inbound",
                      "access": "Allow",
                      "protocol": "Tcp",
                      "sourceAddressPrefix": "[parameters('allowedHttpsSource')]",
                      "sourcePortRange": "*",
                      "destinationAddressPrefix": "*",
                      "destinationPortRange": "443"
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2023-09-01",
              "name": "[variables('containerNicName')]",
              "location": "[parameters('location')]",
              "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]",
                "[resourceId('Microsoft.Network/networkSecurityGroups', variables('containerNsgName'))]"
              ],
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "privateIPAllocationMethod": "Dynamic",
                      "subnet": {
                        "id": "[resourceId(parameters('vnetResourceGroup'), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName'))]"
                      },
                      "publicIPAddress": {
                        "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))]"
                      }
                    }
                  }
                ],
                "networkSecurityGroup": {
                  "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('containerNsgName'))]"
                }
              }
            },
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2023-09-01",
              "name": "[parameters('linuxVmName')]",
              "location": "[parameters('location')]",
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('containerNicName'))]"
              ],
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('linuxVmSize')]"
                },
                "osProfile": {
                  "computerName": "[parameters('linuxVmName')]",
                  "adminUsername": "[parameters('adminUsername')]",
                  "adminPassword": "[parameters('adminPassword')]",
                  "linuxConfiguration": {
                    "disablePasswordAuthentication": false
                  },
                  "customData": "[base64(format(variables('cloudInit'), parameters('acrPassword'), parameters('acrLoginServer'), parameters('acrUsername'), variables('containerImage')))]"
                },
                "storageProfile": {
                  "imageReference": {
                    "publisher": "Canonical",
                    "offer": "0001-com-ubuntu-server-jammy",
                    "sku": "22_04-lts",
                    "version": "latest"
                  },
                  "osDisk": {
                    "createOption": "FromImage",
                    "managedDisk": {
                      "storageAccountType": "StandardSSD_LRS"
                    }
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('containerNicName'))]"
                    }
                  ]
                }
              }
            }
          ],
          "outputs": {
            "containerPublicIp": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))).ipAddress]"
            },
            "containerFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName'))).dnsSettings.fqdn]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "containerPublicIp": {
      "type": "string",
      "value": "[reference('deploy-container-vm').outputs.containerPublicIp.value]"
    },
    "dns": {
      "type": "string",
      "value": "[variables('containerDnsLabel')]"
    },
    "guacamoleUrl": {
      "type": "string",
      "value": "[concat('https://', reference('deploy-container-vm').outputs.containerPublicIp.value, '/guacamole/')]"
    },
    "guacamoleUrlDns": {
      "type": "string",
      "value": "[concat('https://', reference('deploy-container-vm').outputs.containerFqdn.value, '/guacamole/')]"
    },
    "containerName": {
      "type": "string",
      "value": "[variables('linuxVmName')]"
    },
    "resolvedVnetUsed": {
      "type": "string",
      "value": "[concat(reference('resolve-vnet').outputs.vnetResourceGroup.value, '/', reference('resolve-vnet').outputs.vnetName.value)]"
    },
    "resolvedSubnetUsed": {
      "type": "string",
      "value": "[reference('resolve-vnet').outputs.subnetName.value]"
    },
    "resolvedLocationUsed": {
      "type": "string",
      "value": "[reference('resolve-vnet').outputs.location.value]"
    },
    "vnetAddressSpace": {
      "type": "string",
      "value": "[reference('resolve-vnet').outputs.vnetAddressSpace.value]"
    }
  }
}
