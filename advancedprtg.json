{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "adminUsername": {
            "type": "string"
        },
        "adminPassword": {
            "type": "securestring"
        },
        "AzureUserName": {
            "type": "string"
        },
        "AzurePassword": {
            "type": "securestring"
        },
        "ODLID": {
            "type": "string"
        },
        "DeploymentID": {
            "type": "string"
        },
        "trainerUserName": {
            "type": "string"
        },
        "trainerUserPassword": {
            "type": "string"
        },
        "prtg1ImageId": {
            "type": "string",
            "metadata": {
                "description": "Shared Image Gallery image version resource ID for PRTG Core Server 01 (PRTG1)"
            }
        },
        "prtg2ImageId": {
            "type": "string",
            "metadata": {
                "description": "Shared Image Gallery image version resource ID for PRTG Core Server 02 (PRTG2)"
            }
        },
        "rpImageId": {
            "type": "string",
            "metadata": {
                "description": "Shared Image Gallery image version resource ID for the PRTG Remote Probe (RP)"
