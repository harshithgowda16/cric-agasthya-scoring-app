{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "virtualMachineSize": {
      "type": "string"
    },
    "winimageid": {
      "type": "string"
    },
    "winimageid2": {
      "type": "string",
      "metadata": {
        "description": "Image reference for the PRTG Remote Probe VM (L2_remote_probe - Linux, generalized, Gen2, TrustedLaunch)."
      }
    },
    "linimageid2": {
      "type": "string",
      "metadata": {
        "description": "Image reference for PRTG Multi-Platform-Probe VM (sharedimagegallary/images/L2_prtg_mpp). Set mppImageOsState to match the image definition's OS state."
      }
    },
    "mppImageOsState": {
      "type": "string",
      "defaultValue": "Generalized",
      "allowedValues": [
        "Specialized",
        "Generalized"
      ],
      "metadata": {
        "description": "OS state of the linimageid2 image definition. Specialized = no osProfile is sent (login comes from the image). Generalized = osProfile is sent with vmAdminUserName1 / vmAdminPassword."
      }
    },
    "publicIpAddressType": {
      "type": "string"
    },
    "windiskSizeGB": {
      "type": "string"
    },
    "windiskSizeGB2": {
      "type": "string"
    },
    "lindiskSizeGB2": {
      "type": "string"
    },
    "diskType": {
      "type": "string"
    },
    "vmAdminUserName": {
      "type": "string"
    },
    "vmAdminPassword": {
      "type": "securestring"
    },
    "vmAdminUserName1": {
      "type": "string"
    },
    "vmAdminPassword1": {
      "type": "securestring"
    },
    "vmAdminUserName2": {
      "type": "string",
      "metadata": {
        "description": "Not used - the Multi-Platform-Probe admin user is vmAdminUserName1."
      }
    },
    "vmAdminPassword2": {
      "type": "securestring",
      "metadata": {
        "description": "Not used - kept only so existing parameter files do not fail."
      }
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "AzureUserName": {
      "type": "string"
    },
    "AzurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "InstallCloudLabsShadow": {
      "defaultValue": "yes",
      "allowedValues": [
        "yes",
        "no"
      ],
      "type": "string"
    },
    "resetUserPassword": {
      "type": "string"
    },
    "hubResourceGroupName": {
      "type": "string",
      "defaultValue": "paessler-prod-vnet",
      "metadata": {
        "description": "Resource group containing the pre-existing shared VNet (paesslerLab-vNet-<location>) that all lab VMs are placed into directly. This VNet carries the S2S VPN connection to the customer's on-prem network, so the VMs must live inside it rather than in a peered spoke."
      }
    },
    "studentVnetFirstOctet": {
      "type": "string",
      "defaultValue": "10",
      "metadata": {
        "description": "NO LONGER USED. Retained only so existing lab profiles that still pass this parameter do not fail with an unsupported-parameter error. VMs are now attached to the pre-existing hub VNet and receive dynamic private IPs from its address space; no per-deployment spoke VNet is created."
      }
    }
  },
  "variables": {
    "cloudlabsCommon": "[concat(' -AzureUserName ', parameters('AzureUserName'), ' -AzurePassword ', parameters('AzurePassword'), ' -AzureTenantID ', variables('AzureTenantID'), ' -AzureSubscriptionID ', variables('AzureSubscriptionID'), ' -ODLID ', parameters('ODLID'),' -InstallCloudLabsShadow ', parameters('InstallCloudLabsShadow'))]",
    "AzureSubscriptionID": "[subscription().subscriptionId]",
    "AzureTenantID": "[subscription().tenantId]",
    "location": "[resourceGroup().location]",
    "virtualNetworkName": "[concat('paesslerLab-vNet-', variables('location'))]",
    "subnetName": "Subnet",
    "subnetRef": "[resourceId(parameters('hubResourceGroupName'), 'Microsoft.Network/virtualNetworks/subnets', variables('virtualNetworkName'), variables('subnetName'))]",
    "winvirtualMachineName": "PRTG-Core-Server",
    "winComputerName": "[toUpper(take(concat('PRTG', parameters('DeploymentID')), 15))]",
    "networkInterfaceName": "[concat(variables('winvirtualMachineName'), '-nic')]",
    "networkSecurityGroupName": "[concat(variables('winvirtualMachineName'), '-nsg')]",
    "publicIpAddressName": "[concat(variables('winvirtualMachineName'), '-pip')]",
    "publicIpAddressDNSName": "[concat('prtgdns',parameters('DeploymentID'))]",
    "osdiskname": "[concat('PRTGwin-OSDisk-', parameters('DeploymentID'))]",
    "probevirtualMachineName": "PRTG-Remote-Probe",
    "probeComputerName": "[toLower(take(concat('probe', parameters('DeploymentID')), 15))]",
    "networkInterfaceName1": "[concat(variables('probevirtualMachineName'), '-nic')]",
    "networkSecurityGroupName1": "[concat(variables('probevirtualMachineName'), '-nsg')]",
    "publicIpAddressName1": "[concat(variables('probevirtualMachineName'), '-pip')]",
    "publicIpAddressDNSName1": "[concat('prtgprobedns',parameters('DeploymentID'))]",
    "osdiskname1": "[concat('PRTGProbe-OSDisk-', parameters('DeploymentID'))]",
    "linvirtualMachineName2": "PRTG-Multi-Platform-Probe",
    "networkInterfaceName2": "[concat(variables('linvirtualMachineName2'), '-nic')]",
    "networkSecurityGroupName2": "[concat(variables('linvirtualMachineName2'), '-nsg')]",
    "publicIpAddressName2": "[concat(variables('linvirtualMachineName2'), '-pip')]",
    "publicIpAddressDNSName2": "[concat('prtgmppdns',parameters('DeploymentID'))]",
    "osdiskname2": "[concat('PRTGMPP-OSDisk-', parameters('DeploymentID'))]",
    "Enable-CloudLabsEmbeddedShadow": "[concat(' -vmAdminUserName ', parameters('vmAdminUserName') , ' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'))]",
    "mppComputerName": "[variables('mppHostname')]",
    "mppOsProfile": {
      "computerName": "[variables('mppComputerName')]",
      "adminUsername": "[parameters('vmAdminUserName1')]",
      "adminPassword": "[parameters('vmAdminPassword')]",
      "linuxConfiguration": {
        "disablePasswordAuthentication": false,
        "provisionVMAgent": true
      }
    },
    "mppHostname": "prtg-mpp"
  },
  "resources": [
    {
      "apiVersion": "2016-09-01",
      "name": "pid-e843308b-3ce2-42a2-b743-2f21b36a5e68",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      },
      "type": "Microsoft.Resources/deployments"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-rdp",
            "properties": {
              "description": "Allow RDP",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "prtgvm-pip",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('winvirtualMachineName')]",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "osProfile": {
          "computerName": "[variables('winComputerName')]",
          "adminUsername": "[parameters('vmAdminUserName')]",
          "adminPassword": "[parameters('vmAdminPassword')]",
          "windowsConfiguration": {
            "provisionVMAgent": true,
            "enableAutomaticUpdates": true
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('windiskSizeGB')]"
          },
          "imageReference": {
            "id": "[parameters('winimageid')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('winvirtualMachineName'), '/', 'winExtension')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('winvirtualMachineName'))]"
      ],
      "tags": {},
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://experienceazure.blob.core.windows.net/templates/paessler/Lab3/psscript.ps1",
            "https://experienceazure.blob.core.windows.net/templates/cloudlabs-common/cloudlabs-windows-functions.ps1"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File paessler/Lab3/psscript.ps1', variables('cloudlabsCommon'),variables('Enable-CloudLabsEmbeddedShadow'), ' -resetUserPassword ', parameters('resetUserPassword'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName1')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-ssh",
            "properties": {
              "description": "Allow SSH",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName1')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName1'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName1')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "prtgprobevm-pip",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName1'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName1'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName1'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName1'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('probevirtualMachineName')]",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "osProfile": {
          "computerName": "[variables('probeComputerName')]",
          "adminUsername": "[parameters('vmAdminUserName1')]",
          "adminPassword": "[parameters('vmAdminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false,
            "provisionVMAgent": true
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName1'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname1')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('windiskSizeGB2')]"
          },
          "imageReference": {
            "id": "[parameters('winimageid2')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName1'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('probevirtualMachineName'), '/', 'probeProvision')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('probevirtualMachineName'))]"
      ],
      "tags": {},
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {},
        "protectedSettings": {
          "commandToExecute": "[concat('if id -u ', parameters('vmAdminUserName1'), ' >/dev/null 2>&1; then echo \"', parameters('vmAdminUserName1'), ':', parameters('vmAdminPassword1'), '\" | chpasswd; fi; apt-get update && apt-get install -y net-tools curl; exit 0')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName2')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-ssh",
            "properties": {
              "description": "Allow SSH",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 3000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName2')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName2'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName2')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "prtgmppvm-pip",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName2'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName2'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName2'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName2'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('linvirtualMachineName2')]",
      "apiVersion": "2023-03-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "osProfile": "[if(equals(parameters('mppImageOsState'), 'Generalized'), variables('mppOsProfile'), json('null'))]",
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName2'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname2')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('lindiskSizeGB2')]"
          },
          "imageReference": {
            "id": "[parameters('linimageid2')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName2'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('linvirtualMachineName2'), '/', 'mppProvision')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('linvirtualMachineName2'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {},
        "protectedSettings": {
          "commandToExecute": "[concat('if id -u ', parameters('vmAdminUserName1'), ' >/dev/null 2>&1; then echo \"', parameters('vmAdminUserName1'), ':', parameters('vmAdminPassword1'), '\" | chpasswd; fi; OLD=$(hostname); hostnamectl set-hostname ', variables('mppHostname'), '; sed -i \"s/$OLD/', variables('mppHostname'), '/g\" /etc/hosts; grep -q \"^127.0.1.1\" /etc/hosts || echo \"127.0.1.1 ', variables('mppHostname'), '\" >> /etc/hosts; mkdir -p /etc/cloud/cloud.cfg.d; echo \"preserve_hostname: true\" > /etc/cloud/cloud.cfg.d/99-preserve-hostname.cfg; apt-get update && apt-get install -y net-tools curl; exit 0')]"
        }
      }
    }
  ],
  "outputs": {
    "PRTG Core Server DNS Name": {
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))).dnsSettings.fqdn]",
      "type": "string"
    },
    "PRTG Core Server Username": {
      "type": "string",
      "value": "[parameters('vmAdminUserName')]"
    },
    "PRTG Core Server Password": {
      "type": "string",
      "value": "[parameters('resetUserPassword')]"
    },
    "PRTG Core Server Private IP": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))).ipConfigurations[0].properties.privateIPAddress]"
    },
    "PRTG Remote Probe DNS Name": {
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName1'))).dnsSettings.fqdn]",
      "type": "string"
    },
    "PRTG Remote Probe Username": {
      "type": "string",
      "value": "[parameters('vmAdminUserName1')]"
    },
    "PRTG Remote Probe Password": {
      "type": "string",
      "value": "[parameters('vmAdminPassword1')]"
    },
    "PRTG Remote Probe Private IP": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName1'))).ipConfigurations[0].properties.privateIPAddress]"
    },
    "PRTG Multi-Platform-Probe DNS Name": {
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName2'))).dnsSettings.fqdn]",
      "type": "string"
    },
    "PRTG Multi-Platform-Probe Username": {
      "type": "string",
      "value": "[parameters('vmAdminUserName1')]"
    },
    "PRTG Multi-Platform-Probe Password": {
      "type": "string",
      "value": "[parameters('vmAdminPassword1')]"
    },
    "PRTG Multi-Platform-Probe Private IP": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName2'))).ipConfigurations[0].properties.privateIPAddress]"
    }
  }
}
