{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "virtualMachineSize": {
      "type": "string"
    },
    "winimageid": {
      "type": "string"
    },
    "linimageid": {
      "type": "string"
    },
    "linimageid2": {
      "type": "string",
      "metadata": {
        "description": "Image reference for IPCLine1 VM (sharedimagegallary/images/IPCLine1VM-image-OT-lab). NOTE: this is a SPECIALIZED image, so no osProfile is supplied for this VM - login credentials are whatever was baked into the image when it was captured."
      }
    },
    "publicIpAddressType": {
      "type": "string"
    },
    "windiskSizeGB": {
      "type": "string"
    },
    "lindiskSizeGB": {
      "type": "string"
    },
    "lindiskSizeGB2": {
      "type": "string"
    },
    "diskType": {
      "type": "string"
    },
    "vmAdminUserName": {
      "type": "string"
    },
    "vmAdminPassword": {
      "type": "securestring"
    },
    "vmAdminUserName1": {
      "type": "string"
    },
    "vmAdminPassword1": {
      "type": "securestring"
    },
    "vmAdminUserName2": {
      "type": "string",
      "metadata": {
        "description": "Not applied to the VM (specialized image) - kept only in case you want to display it in outputs for reference."
      }
    },
    "vmAdminPassword2": {
      "type": "securestring",
      "metadata": {
        "description": "Not applied to the VM (specialized image) - kept only in case you want to display it in outputs for reference."
      }
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "AzureUserName": {
      "type": "string"
    },
    "AzurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "InstallCloudLabsShadow": {
      "defaultValue": "yes",
      "allowedValues": [
        "yes",
        "no"
      ],
      "type": "string"
    },
    "resetUserPassword": {
      "type": "string"
    },
    "hubResourceGroupName": {
      "type": "string",
      "defaultValue": "paessler-prod-vnet",
      "metadata": {
        "description": "Resource group containing the shared hub VNet (paesslerLab-vNet-<location>) that every student spoke peers to."
      }
    },
    "studentVnetBaseOctets": {
      "type": "string",
      "defaultValue": "10.50",
      "metadata": {
        "description": "First two octets for student spoke VNets (e.g. '10.50'). The third octet is derived per-deployment from DeploymentID to avoid VnetAddressSpaceOverlapsWithAlreadyPeeredVnet errors against other networks already peered to the hub. IMPORTANT: do NOT override this to '10.3' - that block is already used by a peered vnet (paesslerLab-vNet-germanywestcentral). If 10.50.x.0/24 also collides, pick another unused /16 such as '10.60'."
      }
    }
  },
  "variables": {
    "cloudlabsCommon": "[concat(' -AzureUserName ', parameters('AzureUserName'), ' -AzurePassword ', parameters('AzurePassword'), ' -AzureTenantID ', variables('AzureTenantID'), ' -AzureSubscriptionID ', variables('AzureSubscriptionID'), ' -ODLID ', parameters('ODLID'),' -InstallCloudLabsShadow ', parameters('InstallCloudLabsShadow'))]",
    "AzureSubscriptionID": "[subscription().subscriptionId]",
    "AzureTenantID": "[subscription().tenantId]",
    "location": "[resourceGroup().location]",
    "hubVirtualNetworkName": "[concat('paesslerLab-vNet-', variables('location'))]",
    "hubVirtualNetworkId": "[resourceId(parameters('hubResourceGroupName'), 'Microsoft.Network/virtualNetworks', variables('hubVirtualNetworkName'))]",
    "studentVirtualNetworkName": "[concat('student-vnet-', parameters('DeploymentID'))]",
    "studentVnetThirdOctet": "[string(mod(int(parameters('DeploymentID')), 250))]",
    "studentVnetAddressPrefix": "[concat(parameters('studentVnetBaseOctets'), '.', variables('studentVnetThirdOctet'), '.0/24')]",
    "prtgPrivateIP": "[concat(parameters('studentVnetBaseOctets'), '.', variables('studentVnetThirdOctet'), '.10')]",
    "ignitionPrivateIP": "[concat(parameters('studentVnetBaseOctets'), '.', variables('studentVnetThirdOctet'), '.11')]",
    "ipclinePrivateIP": "[concat(parameters('studentVnetBaseOctets'), '.', variables('studentVnetThirdOctet'), '.12')]",
    "subnetName": "Subnet",
    "subnetRef": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('studentVirtualNetworkName'), variables('subnetName'))]",
    "spokeToHubPeeringName": "[concat(variables('studentVirtualNetworkName'), '/to-hub')]",
    "hubToSpokePeeringName": "[concat(variables('hubVirtualNetworkName'), '/to-', variables('studentVirtualNetworkName'))]",
    "winvirtualMachineName": "PRTG-Core-Server",
    "winComputerName": "[toUpper(take(concat('PRTG', parameters('DeploymentID')), 15))]",
    "networkInterfaceName": "[concat(variables('winvirtualMachineName'), '-nic')]",
    "networkSecurityGroupName": "[concat(variables('winvirtualMachineName'), '-nsg')]",
    "publicIpAddressName": "[concat(variables('winvirtualMachineName'), '-pip')]",
    "publicIpAddressDNSName": "[concat('prtgdns',parameters('DeploymentID'))]",
    "osdiskname": "[concat('PRTGwin-OSDisk-', parameters('DeploymentID'))]",
    "linvirtualMachineName": "Ignition-Gateway-SCADA",
    "networkInterfaceName1": "[concat(variables('linvirtualMachineName'), '-nic')]",
    "networkSecurityGroupName1": "[concat(variables('linvirtualMachineName'), '-nsg')]",
    "publicIpAddressName1": "[concat(variables('linvirtualMachineName'), '-pip')]",
    "publicIpAddressDNSName1": "[concat('ubuntudns',parameters('DeploymentID'))]",
    "osdiskname1": "[concat('Ubuntu-OSDisk-', parameters('DeploymentID'))]",
    "linvirtualMachineName2": "IPCLine1",
    "networkInterfaceName2": "[concat(variables('linvirtualMachineName2'), '-nic')]",
    "networkSecurityGroupName2": "[concat(variables('linvirtualMachineName2'), '-nsg')]",
    "publicIpAddressName2": "[concat(variables('linvirtualMachineName2'), '-pip')]",
    "publicIpAddressDNSName2": "[concat('ipclinedns',parameters('DeploymentID'))]",
    "osdiskname2": "[concat('IPCLine1-OSDisk-', parameters('DeploymentID'))]",
    "Enable-CloudLabsEmbeddedShadow": "[concat(' -vmAdminUserName ', parameters('vmAdminUserName') , ' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'))]"
  },
  "resources": [
    {
      "apiVersion": "2016-09-01",
      "name": "pid-e843308b-3ce2-42a2-b743-2f21b36a5e68",
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": []
        }
      },
      "type": "Microsoft.Resources/deployments"
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "name": "[variables('studentVirtualNetworkName')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('studentVnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "[variables('studentVnetAddressPrefix')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "name": "[variables('spokeToHubPeeringName')]",
      "apiVersion": "2020-08-01",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
      ],
      "properties": {
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false,
        "remoteVirtualNetwork": {
          "id": "[variables('hubVirtualNetworkId')]"
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "name": "[concat('hubPeering-', parameters('DeploymentID'))]",
      "apiVersion": "2021-04-01",
      "resourceGroup": "[parameters('hubResourceGroupName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": [
            {
              "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
              "name": "[variables('hubToSpokePeeringName')]",
              "apiVersion": "2020-08-01",
              "properties": {
                "allowVirtualNetworkAccess": true,
                "allowForwardedTraffic": false,
                "allowGatewayTransit": false,
                "useRemoteGateways": false,
                "remoteVirtualNetwork": {
                  "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-rdp",
            "properties": {
              "description": "Allow RDP",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "prtgvm-pip",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('prtgPrivateIP')]",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('winvirtualMachineName')]",
      "apiVersion": "2018-06-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "osProfile": {
            "computerName": "[variables('winComputerName')]",
            "adminUsername": "[parameters('vmAdminUserName')]",
            "adminPassword": "[parameters('vmAdminPassword')]",
            "windowsConfiguration": {
                "provisionVMAgent": true,
                "enableAutomaticUpdates": true
            }
        },        
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('windiskSizeGB')]"
          },
          "imageReference": {
            "id": "[parameters('winimageid')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('winvirtualMachineName'), '/', 'winExtension')]",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('winvirtualMachineName'))]"
      ],
      "tags": {},
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://experienceazure.blob.core.windows.net/templates/paessler/Lab3/psscript.ps1",
            "https://experienceazure.blob.core.windows.net/templates/cloudlabs-common/cloudlabs-windows-functions.ps1"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File paessler/Lab3/psscript.ps1', variables('cloudlabsCommon'),variables('Enable-CloudLabsEmbeddedShadow'), ' -resetUserPassword ', parameters('resetUserPassword'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName1')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-rdp",
            "properties": {
              "description": "Allow RDP",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-ssh",
            "properties": {
              "description": "Allow SSH",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 3000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName1')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName1'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName1')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "linvm-pip",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('ignitionPrivateIP')]",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName1'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName1'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName1'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName1'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('linvirtualMachineName')]",
      "apiVersion": "2018-06-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName1'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname1')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('lindiskSizeGB')]"
          },
          "imageReference": {
            "id": "[parameters('linimageid')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName1'))]"
      ]
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "name": "[variables('networkSecurityGroupName2')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-https",
            "properties": {
              "description": "Allow HTTPS",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 2000,
              "direction": "Inbound"
            }
          },
          {
            "name": "default-allow-ssh",
            "properties": {
              "description": "Allow SSH",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 3000,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "name": "[variables('publicIpAddressName2')]",
      "apiVersion": "2020-08-01",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[concat(variables('publicIpAddressDNSName2'))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "name": "[variables('networkInterfaceName2')]",
      "apiVersion": "2015-06-15",
      "location": "[variables('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipclinevm-pip",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "[variables('ipclinePrivateIP')]",
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "publicIPAddress": {
                "id": "[resourceId(resourceGroup().name,'Microsoft.Network/publicIpAddresses', variables('publicIpAddressName2'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName2'))]"
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/publicIpAddresses/', variables('publicIpAddressName2'))]",
        "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSecurityGroupName2'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('studentVirtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "name": "[variables('linvirtualMachineName2')]",
      "apiVersion": "2018-06-01",
      "location": "[variables('location')]",
      "tags": {},
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('virtualMachineSize')]"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName2'))]"
            }
          ]
        },
        "storageProfile": {
          "osDisk": {
            "createOption": "FromImage",
            "name": "[variables('osdiskname2')]",
            "caching": "ReadWrite",
            "managedDisk": {
              "storageAccountType": "[parameters('diskType')]"
            },
            "diskSizeGB": "[parameters('lindiskSizeGB2')]"
          },
          "imageReference": {
            "id": "[parameters('linimageid2')]"
          }
        }
      },
      "dependsOn": [
        "[concat('Microsoft.Network/networkInterfaces/', variables('networkInterfaceName2'))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2015-06-15",
      "name": "[concat(variables('linvirtualMachineName2'), '/', 'ipclineProvision')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[concat('Microsoft.Compute/virtualMachines/', variables('linvirtualMachineName2'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.Extensions",
        "type": "CustomScript",
        "typeHandlerVersion": "2.1",
        "autoUpgradeMinorVersion": true,
        "settings": {},
        "protectedSettings": {
          "commandToExecute": "sudo apt-get update && sudo apt-get install -y net-tools curl"
        }
      }
    }
  ],
  "outputs": {
  "PRTG Core Server DNS Name": {
    "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))).dnsSettings.fqdn]",
    "type": "string"
  },
  "PRTG Core Server Username": {
    "type": "string",
    "value": "[parameters('vmAdminUserName')]"
  },
  "PRTG Core Server Password": {
    "type": "string",
    "value": "[parameters('resetUserPassword')]"
  },
  "PRTG Core Server Private IP": {
    "type": "string",
    "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))).ipConfigurations[0].properties.privateIPAddress]"
  },
  "Ignition Gateway SCADA DNS Name": {
    "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName1'))).dnsSettings.fqdn]",
    "type": "string"
  },
  "Ignition Gateway SCADA Username": {
    "type": "string",
    "value": "[parameters('vmAdminUserName1')]"
  },
  "Ignition Gateway SCADA Password": {
    "type": "string",
    "value": "[parameters('vmAdminPassword1')]"
  },
  "Ignition Gateway SCADA Private IP": {
    "type": "string",
    "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName1'))).ipConfigurations[0].properties.privateIPAddress]"
  },
  "IPCLine1 DNS Name": {
    "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName2'))).dnsSettings.fqdn]",
    "type": "string"
  },
  "IPCLine1 Credentials Note": {
    "type": "string",
    "value": "Specialized image - login credentials are whatever was baked into the image at capture time, not the vmAdminUserName2/vmAdminPassword2 parameters."
  },
  "IPCLine1 Private IP": {
    "type": "string",
    "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName2'))).ipConfigurations[0].properties.privateIPAddress]"
  }
 }
}
